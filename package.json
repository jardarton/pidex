{
  "name": "pidex",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run scripts/workspaces.mjs check && bun run knip",
    "typecheck": "bun run scripts/workspaces.mjs typecheck",
    "test": "bun run scripts/workspaces.mjs test",
    "pack:dry": "bun run scripts/workspaces.mjs pack:dry",
    "check:changed": "bun run scripts/check-changed.mjs",
    "knip": "knip --workspace @howaboua/pi-codex-conversion --no-progress --include files,dependencies,unlisted,unresolved,cycles,exports,nsExports,types,nsTypes,enumMembers,namespaceMembers,duplicates"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.10.0",
    "knip": "^6.29.0",
    "oxfmt": "^0.35.0"
  },
  "version": "0.0.0"
}
